<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android"
    class="com.valentin.despertador.ui.widget.Styled$Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="17dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFF2F4F8"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:letterSpacing="0.125"
                android:textAllCaps="true"
                android:textColor="#FFB2B9C8"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFB2B9C8"
            android:textSize="12sp" />

        <view
            android:id="@+id/rapida"
            class="com.valentin.despertador.ui.widget.Styled$AccentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <com.valentin.despertador.ui.widget.ToggleView
        android:id="@+id/interruptor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</view>
