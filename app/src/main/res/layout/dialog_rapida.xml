<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alarma rápida"
        android:textColor="#FFF2F4F8"
        android:textSize="23sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.valentin.despertador.ui.widget.WheelView
            android:id="@+id/horas"
            android:layout_width="80dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="h"
            android:textColor="#FFB2B9C8"
            android:textSize="20sp" />

        <com.valentin.despertador.ui.widget.WheelView
            android:id="@+id/minutos"
            android:layout_width="80dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="min"
            android:textColor="#FFB2B9C8"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <view
            android:id="@+id/cancelar"
            class="com.valentin.despertador.ui.widget.Styled$GhostButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="Cancelar"
            android:textSize="16sp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <view
            android:id="@+id/aceptar"
            class="com.valentin.despertador.ui.widget.Styled$AccentButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="Aceptar"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
